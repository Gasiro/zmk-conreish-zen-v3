#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
// --------------------------------------------------------------------------------
// |  ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// |  TAB |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ↑  | ENTER|
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  ←  |  ↓  |   →  |
//                    | GUI |SPC 1|SPC 1|   |SPC 2|SPC  2|ALT 2|
            bindings = <
&kp ESC     &kp Q       &kp W       &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
&kp TAB     &kp A       &kp S       &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp UP &kp ENTER
&kp LSHFT   &kp Z       &kp X       &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp LEFT &kp DOWN &kp RIGHT
                                     &kp LGUI &lt 1 SPACE &lt 1 SPACE   &lt 2 SPACE &lt 2 SPACE &lt 2 RALT
            >;
        };

        lower_layer {
            display-name = "NUMBER";
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | CAPS |     |  `  |  ~  |  -  |  =  |   |     |     |     |     |  ;  |      |
// | SHFT |     |     |     |     |     |   |     |     |     |  .  |  '  |  /   |
//                    | GUI | PLAY| SPC |   | ENT |     | ALT |
            bindings = <
&kp TAB    &kp N1      &kp N2      &kp N3       &kp N4      &kp N5        &kp N6     &kp N7   &kp N8      &kp N9     &kp N0    &kp BSPC
&kp CAPS   &trans      &kp GRAVE   &kp TILDE    &kp MINUS   &kp EQUAL     &trans     &trans   &trans      &trans     &kp SEMI  &trans
&kp LSHFT  &trans      &trans      &trans       &trans      &trans        &trans     &trans   &trans      &kp DOT    &kp SQT   &kp SLASH
                               &kp LGUI   &kp C_PLAY_PAUSE  &kp SPACE     &kp SPACE  &trans   &kp RALT
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// |BTCLR | BT1 | BT2 | BT3 | BT4 | BT5 |   |     |VOLUP|  [  |  ]  |  ;  |      |
// |BTCLRA|     |     |     |     |     |   |ScBRD|VOLDN|ScBRI|  .  |  '  |  \   |
//                    | GUI |     | STU |   | STU |     | ALT |
            bindings = <
&kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5        &kp N6     &kp N7      &kp N8       &kp N9      &kp N0      &kp BSPC
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4  &trans     &kp C_VOLUME_UP &kp LBKT &kp RBKT    &kp SEMI    &trans
&kp BT_CLR_ALL  &trans       &trans       &trans       &trans       &trans        &kp C_BRIGHTNESS_DEC &kp C_VOLUME_DOWN &kp C_BRIGHTNESS_INC &kp DOT    &kp SQT   &kp BSLH
                        &kp LGUI &trans   &studio_unlock   &studio_unlock   &trans    &kp RALT
            >;
        };
    };
};
